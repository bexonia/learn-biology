# Generated 3D and WebAssembly binaries (build with `python build_assets.py`)
*.glb
!client/public/models/*.glb
*.wasm
wasm/*.wasm
models/*.glb

# Blender auto-save backups (source .blend is preserved)
*.blend1
*.blend2
*.blend@*
*.blend.MNSession

# Python & Environment caches
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/

# OS metadata & logs
Thumbs.db
.DS_Store
*.log
.playwright-mcp/
node_modules/
scratch/

# Temporary & debug screenshots (curated docs live in readme_images/)
screenshot*.png
screenshot_*.png
*.tmp.png
!readme_images/*.png
!assets/**/*.png

# Package manager (pnpm is the workspace standard, ignore npm lockfile)
package-lock.json
