# Generated 3D and WebAssembly binaries (build with `python prokaryote/scripts/build_assets.py`)
*.glb
!client/public/prokaryote/models/*.glb
!client/public/eukaryote/models/*.glb
*.wasm
wasm/*.wasm
prokaryote/models/*.glb
eukaryote/models/*.glb
*.cif
prokaryote/models/*.cif
eukaryote/models/*.cif

# Blender auto-save backups & generated .blend files
*.blend1
*.blend2
*.blend@*
*.blend.MNSession
prokaryote/models/*.blend
!prokaryote/models/prokaryote_cell.blend
!prokaryote/models/atp_synthase_6rkw.blend
!prokaryote/models/bam_5d0o.blend
