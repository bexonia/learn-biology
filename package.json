{
  "name": "learn-biology",
  "version": "2.0.0",
  "description": "Interactive 3D Cellular & Molecular Biology WebGL Explorer powered by Three.js, TypeScript, and Effect",
  "type": "module",
  "scripts": {
    "dev:web": "esbuild src/pages/*.ts --bundle --splitting --format=esm --outdir=dist --outbase=src --target=es2022 --external:three --external:three/* --watch=forever",
    "dev:server": "tsx watch src/server/auth_progress_server.ts",
    "dev": "LEARN_STATIC_ROOT=. PORT=8765 tsx src/server/auth_progress_server.ts",
    "start": "LEARN_STATIC_ROOT=. PORT=8765 node dist/server.js",
    "start:api": "PORT=3001 node dist/server.js",
    "build": "esbuild src/pages/*.ts --bundle --splitting --minify --format=esm --outdir=dist --outbase=src --target=es2022 --external:three --external:three/* && esbuild src/server/auth_progress_server.ts --bundle --platform=node --format=esm --outfile=dist/server.js --target=node22 --external:node:*",
    "export:cues": "tsx scripts/export_tour_cues.ts",
    "generate:narration": "npm run export:cues && python3 tools/generate_narration_gptsovits.py",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/verify_all.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bexonia/learn-biology.git"
  },
  "license": "MIT",
  "homepage": "https://learn.bexonia.com",
  "dependencies": {
    "effect": "^4.1.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
